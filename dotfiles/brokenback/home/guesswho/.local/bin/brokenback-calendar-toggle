#!/usr/bin/env sh
set -eu

config="${HOME}/.config/eww/brokenback-hub"
cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/brokenback"
log_file="${cache_dir}/eww-calendar-hub.log"

mkdir -p "$cache_dir"

if [ -z "${DISPLAY:-}" ]; then
  export DISPLAY=:0
fi

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "/run/user/$(id -u)/bus" ]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi

if [ -z "${BSPWM_SOCKET:-}" ]; then
  for socket in /tmp/bspwm_*_0-socket /tmp/bspwm*-socket; do
    [ -S "$socket" ] || continue
    export BSPWM_SOCKET="$socket"
    break
  done
fi

if ! command -v eww >/dev/null 2>&1; then
  notify-send "BrokenBack calendar" "Eww is not installed yet" >/dev/null 2>&1 || true
  exit 1
fi

daemon_helper="${HOME}/.local/bin/brokenback-eww-daemon"
if ! "$daemon_helper" "$config" >/dev/null 2>&1; then
  notify-send "BrokenBack calendar" "Eww daemon failed to start" >/dev/null 2>&1 || true
  exit 1
fi

eww_close() {
  timeout 2s eww --config "$config" close "$@" >>"$log_file" 2>&1 || true
}

eww_open() {
  if timeout 3s eww --config "$config" open "$1" >>"$log_file" 2>&1; then
    return 0
  fi

  "$daemon_helper" "$config" >/dev/null 2>&1 || true
  timeout 3s eww --config "$config" open "$1" >>"$log_file" 2>&1 || true
}

active_windows="$(timeout 2s eww --config "$config" active-windows 2>>"$log_file" || true)"

# Toggle logic
if printf '%s\n' "$active_windows" | grep -q "^brokenback_calendar_hub:"; then
  eww_close brokenback_calendar_hub brokenback_calendar_background
else
  eww_close brokenback_hub brokenback_hub_background
  eww_open brokenback_calendar_background
  eww_open brokenback_calendar_hub
fi
