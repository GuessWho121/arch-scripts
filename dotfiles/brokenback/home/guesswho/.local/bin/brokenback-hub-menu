#!/usr/bin/env sh
set -eu

theme="${HOME}/.config/rofi/surface-hub.rasi"

strip_polybar_tags() {
  sed -E 's/%\{T[0-9]+\}//g; s/%\{T-\}//g; s/%\{F#[0-9A-Fa-f]+\}//g; s/%\{F-\}//g; s/%\{A[^}]*\}//g'
}

wifi="offline"
if command -v nmcli >/dev/null 2>&1; then
  wifi="$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')"
  [ -n "$wifi" ] || wifi="$(nmcli -t -f DEVICE,STATE dev status 2>/dev/null | awk -F: '$2=="connected"{print $1; exit}')"
  [ -n "$wifi" ] || wifi="offline"
fi

bt="$(~/.local/bin/brokenback-bluetooth-status 2>/dev/null || printf 'off')"
battery="$(~/.local/bin/brokenback-battery-status 2>/dev/null | strip_polybar_tags || printf 'battery n/a')"
media="$(~/.local/bin/brokenback-media-status 2>/dev/null | strip_polybar_tags || printf 'no media')"
updates="$(~/.local/bin/brokenback-update-status 2>/dev/null | strip_polybar_tags || printf 'updates n/a')"

volume="n/a"
if command -v wpctl >/dev/null 2>&1; then
  volume="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "%d%%", $2 * 100}')"
fi

brightness="n/a"
if command -v brightnessctl >/dev/null 2>&1; then
  brightness="$(brightnessctl -m 2>/dev/null | awk -F, '{print $4}' | head -n1)"
fi

dnd="off"
if command -v dunstctl >/dev/null 2>&1 && dunstctl is-paused 2>/dev/null | grep -q true; then
  dnd="on"
fi

cpu="$(awk '/^cpu /{usage=($2+$4)*100/($2+$4+$5); printf \"%d%%\", usage}' /proc/stat 2>/dev/null || printf '0%')"
ram="$(free 2>/dev/null | awk '/Mem:/{printf \"%d%%\", $3*100/$2}' || printf '0%')"
uptime="$(uptime -p 2>/dev/null | sed 's/^up //')"
[ -n "$uptime" ] || uptime="just now"

choice="$(printf '%s\n' \
  " ${USER}     ${cpu}     ${ram}" \
  " Wi-Fi: ${wifi}" \
  "󰂯 Bluetooth: ${bt}" \
  " Volume: ${volume}" \
  "󰃠 Brightness: ${brightness}" \
  "󰂃 Battery: ${battery}" \
  "󰏗 Updates available: ${updates}" \
  "󰓇 Media: ${media}" \
  "󰂛 DND: ${dnd}" \
  "󰄀 Screenshot area" \
  "󰐥 Power menu" \
  " Lock" \
  "󰔛 Uptime: ${uptime}" \
  | rofi -dmenu -i -p hub -theme "$theme")" || exit 0

[ -n "$choice" ] || exit 0

case "$choice" in
  *Wi-Fi:*)
    alacritty -e nmtui >/dev/null 2>&1 &
    ;;
  *Bluetooth:*)
    brokenback-bluetooth-menu >/dev/null 2>&1 &
    ;;
  *Volume:*)
    pavucontrol >/dev/null 2>&1 &
    ;;
  *Brightness:*)
    brightnessctl set 5%+ >/dev/null 2>&1 || true
    ;;
  *Media:*)
    playerctl play-pause >/dev/null 2>&1 || true
    ;;
  *DND:*)
    if [ "$dnd" = "on" ]; then
      dunstctl set-paused false
    else
      dunstctl set-paused true
    fi
    ;;
  *Screenshot*)
    brokenback-screenshot area >/dev/null 2>&1 &
    ;;
  *Power*)
    brokenback-session-menu >/dev/null 2>&1 &
    ;;
  *Lock)
    /usr/local/bin/brokenback-lock
    ;;
esac
