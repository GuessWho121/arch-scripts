configuration {
    show-icons: false;
    font: "SpaceMono Nerd Font Mono 10";
    matching: "fuzzy";
    sort: false;
    click-to-exit: true;
}

* {
    background: #101418f2;
    card: #1f282df0;
    card-alt: #273238f0;
    foreground: #dce8e6;
    muted: #879692;
    accent: #7ddfe8;
    accent-alt: #c6d69a;
    peach: #ffb08a;
    danger: #ff7a90;
    divider: #7ddfe83d;
}

window {
    transparency: "real";
    location: northeast;
    anchor: northeast;
    fullscreen: false;
    width: 350px;
    x-offset: -10px;
    y-offset: 48px;
    border-radius: 24px;
    border: 1px;
    border-color: @divider;
    background-color: @background;
}

mainbox {
    spacing: 12px;
    padding: 14px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    padding: 10px 12px;
    border-radius: 16px;
    background-color: @card;
    text-color: @foreground;
    children: [ "prompt", "entry" ];
}

prompt {
    str: "hub";
    padding: 0 10px 0 0;
    text-color: @accent-alt;
}

entry {
    placeholder: "type to filter";
    placeholder-color: @muted;
    text-color: @foreground;
    background-color: transparent;
}

listview {
    enabled: true;
    columns: 1;
    lines: 12;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    fixed-height: false;
    spacing: 8px;
    background-color: transparent;
    text-color: @foreground;
}

element {
    padding: 12px 13px;
    border-radius: 14px;
    background-color: @card;
    text-color: @foreground;
    cursor: pointer;
}

element selected {
    background-color: @card-alt;
    border: 1px;
    border-color: @accent;
    text-color: @foreground;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}
