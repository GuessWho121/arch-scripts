[global]
    monitor = 0
    follow = keyboard
    width = 360
    height = 220
    origin = top-right
    offset = 12x52
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 120
    progress_bar_max_width = 320
    indicate_hidden = yes
    transparency = 8
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 8
    frame_width = 1
    frame_color = "#7ddfe8"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = SpaceMono Nerd Font Mono 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    corner_radius = 8
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#141a1f"
    foreground = "#9aa9a6"
    timeout = 4

[urgency_normal]
    background = "#1f282d"
    foreground = "#dce8e6"
    timeout = 7

[urgency_critical]
    background = "#2a1d24"
    foreground = "#ffd5de"
    frame_color = "#ff7a90"
    timeout = 0
