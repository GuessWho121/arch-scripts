#!/usr/bin/env sh

export PATH="${HOME}/.local/bin:${PATH}"
export CM_LAUNCHER=rofi
export CM_SELECTIONS=clipboard
export CM_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/clipmenu"
export GTK_THEME=Materia-dark
export QT_QPA_PLATFORMTHEME=qt5ct
export QT_STYLE_OVERRIDE=kvantum

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd DISPLAY XAUTHORITY DESKTOP_SESSION XDG_CURRENT_DESKTOP >/dev/null 2>&1
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user import-environment DISPLAY XAUTHORITY PATH GTK_THEME QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE >/dev/null 2>&1
fi

bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width 2
bspc config window_gap 10
bspc config top_padding 44
bspc config split_ratio 0.52
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config single_monocle false
bspc config focus_follows_pointer false
bspc config pointer_follows_focus false
bspc config normal_border_color '#172126'
bspc config active_border_color '#263238'
bspc config focused_border_color '#7ddfe8'
bspc config presel_feedback_color '#ffb08a'

bspc rule -a Pavucontrol state=floating center=true
bspc rule -a Blueman-manager state=floating center=true
bspc rule -a Lxappearance state=floating center=true
bspc rule -a Qt5ct state=floating center=true
bspc rule -a Qt6ct state=floating center=true
bspc rule -a Kvantum\ Manager state=floating center=true
bspc rule -a flameshot state=floating center=true

if command -v xset >/dev/null 2>&1; then
  xset s off -dpms >/dev/null 2>&1
fi

home_wallpaper="${HOME}/Pictures/wallpaper/home/wallpaper.jpg"
if command -v feh >/dev/null 2>&1 && [ -f "$home_wallpaper" ]; then
  feh --bg-fill "$home_wallpaper" >/dev/null 2>&1 &
fi

run_once() {
  name="$1"
  shift
  if ! pgrep -u "${USER}" -x "$name" >/dev/null 2>&1; then
    "$@" >/dev/null 2>&1 &
  fi
}

run_once sxhkd sxhkd
run_once dunst dunst -conf "${HOME}/.config/dunst/dunstrc"
run_once picom picom --config "${HOME}/.config/picom/picom.conf"
run_once blueman-applet blueman-applet
run_once clipnotify clipmenud

if command -v brokenback-eww-launch >/dev/null 2>&1; then
  brokenback-eww-launch >/dev/null 2>&1 &
fi

if command -v brokenback-workspace-pill-watch >/dev/null 2>&1 && ! pgrep -u "${USER}" -f '[b]rokenback-workspace-pill-watch' >/dev/null 2>&1; then
  brokenback-workspace-pill-watch >/dev/null 2>&1 &
fi

if command -v brokenback-polybar-launch >/dev/null 2>&1; then
  brokenback-polybar-launch >/dev/null 2>&1 &
fi

if ! pgrep -u "${USER}" -x xss-lock >/dev/null 2>&1; then
  xss-lock --transfer-sleep-lock -- /usr/local/bin/brokenback-lock >/dev/null 2>&1 &
fi
